{
  "manifest_version": 3,
  "name": "Chapter Collector",
  "version": "3.1",
  "description": "Collect chapters from WebNovel, Royal Road, and FreeWebNovel for personal analysis",
  "permissions": ["storage", "scripting", "activeTab", "downloads"],
  "host_permissions": [
    "https://www.webnovel.com/*",
    "https://www.royalroad.com/*",
    "https://freewebnovel.net/*",
    "https://www.freewebnovel.net/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://www.webnovel.com/book/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.webnovel.com/book/*"],
      "js": ["content-wn-main.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.royalroad.com/fiction/*/chapter/*"],
      "js": ["content-rr.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://freewebnovel.net/*", "https://www.freewebnovel.net/*"],
      "js": ["freewebnovel.js", "content-fwn.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon.png"
    }
  }
}
